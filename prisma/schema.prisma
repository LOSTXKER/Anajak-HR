  id                                                          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id                                                 String     @db.Uuid
  action                                                      String     @db.VarChar(20)
  effective_date                                              DateTime   @db.Date
  reason                                                      String?
  performed_by                                                String?    @db.Uuid
  created_at                                                  DateTime?  @default(now()) @db.Timestamptz(6)
  /// Phase B: tenant scope — nullable until Step 2 backfill
  organization_id                                             String?    @db.Uuid
  employees_employment_history_employee_idToemployees         employees  @relation("employment_history_employee_idToemployees", fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employees_employment_history_performed_byToemployees        employees? @relation("employment_history_performed_byToemployees", fields: [performed_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  organizations                                               organizations? @relation(fields: [organization_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([employee_id], map: "idx_employment_history_employee")
  @@index([created_at(sort: Desc)], map: "idx_employment_history_created")
  @@index([organization_id], map: "idx_employment_history_org")
}

